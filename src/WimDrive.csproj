<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WimDriverMount</AssemblyName>
    <!-- Bump this with every change worth telling apart. A version left unchanged
         across many changes makes every bug report ambiguous:
         one number names many different programs. build.ps1
         stamps SourceRevisionId with the commit, so the version option
         identifies the exact source a binary came from. -->
    <Version>0.10.0</Version>
    <Authors>Jericho Jones</Authors>
    <!-- MIT: everything here is Jericho's own work or permissive. Solid-resource
         support was rewritten clean-room (WimReader/SOURCE-NOTICES.md); keep
         code derived from non-permissive sources off the read path. -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <ApplicationIcon>artwork\wimdrivermount-icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Native code; does not use the standard .NET runtime (CoreCLR). A copy started as
         administrator gets its environment from HKCU\Environment, which any program the
         user runs can write. CoreCLR obeys some of those variables before Main: a profiler,
         a GC DLL (DOTNET_GCName), startup hooks, EventPipe files. NativeAOT has none of
         them, so the administrator copy, its workers and an administrator console are
         all out of their reach. Its own GC still reads a few DOTNET_GC* tuning settings.
         One file still: no runtime files beside it. -->
    <PublishAot>true</PublishAot>
    <!-- JSON code is generated at build time (JsonSerializerContext); a call that
         would need reflection fails in every build, not only the published one. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup>
    <!-- The exe names its symbol file without the build machine's folder. -->
    <LinkerArg Include="/PDBALTPATH:%25_PDB%25" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="WimReader/DiscUtils.Wim.csproj" />
    <PackageReference Include="LTRData.DiscUtils.MountDokan" Version="[1.0.89]" />
    <PackageReference Include="DokanNet" Version="[2.3.0.3]" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="WimReader/**/*.cs" />
    <EmbeddedResource Include="artwork/wimdrivermount-splash.ansi" LogicalName="WimDriverMount.Splash" />
    <EmbeddedResource Include="artwork/wimdrivermount-splash-large.ansi" LogicalName="WimDriverMount.SplashLarge" />
    <!-- What the install command writes beside the program, carried inside it (ProgramInstall). -->
    <EmbeddedResource Include="licenses/*" LogicalName="Install/licenses/%(Filename)%(Extension)" />
    <EmbeddedResource Include="WimReader/SOURCE-NOTICES.md" LogicalName="Install/licenses/WIMREADER-SOURCE-NOTICES.md" />
  </ItemGroup>
</Project>
